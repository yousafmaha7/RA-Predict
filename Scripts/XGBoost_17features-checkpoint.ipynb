    "grid_search = GridSearchCV(estimator=xgb, param_grid=PARAM_GRID, cv=CV_FOLDS,\n",
    "                           scoring=\"roc_auc\", n_jobs=1, verbose=1)\n",
    "grid_search.fit(X_train, y_train)\n",
    "\n",
    "if USE_MANUSCRIPT_PARAMS:\n",
    "    best_params = dict(EXPECTED_PARAMS)\n",
    "    best_model = XGBClassifier(objective=\"binary:logistic\", eval_metric=\"logloss\",\n",
    "                               random_state=SEED, **best_params)\n",
    "    cv_auc = cross_val_score(best_model, X_train, y_train, cv=CV_FOLDS, scoring=\"roc_auc\").mean()\n",
    "    best_model.fit(X_train, y_train)\n",
    "    print(\"Final model uses the parameters of Table 3 (the search is kept for the diagnostics only)\")\n",
    "else:\n",
    "    best_params = grid_search.best_params_\n",
    "    best_model = grid_search.best_estimator_\n",
    "    cv_auc = grid_search.best_score_\n",
    "\n",
    "print(\"Parameters of the final model:\", best_params)\n",
    "print(f\"CV ROC-AUC of the final model: {cv_auc:.4f}\")\n",
    "print(\"Search winner:\", grid_search.best_params_, f\"(CV ROC-AUC {grid_search.best_score_:.4f})\")\n",
