    "# ============================================================\n",
    "# 95% BOOTSTRAP CONFIDENCE INTERVALS (test set, percentile method)\n",
    "# These describe the sampling variability of the 80 test patients for this fitted\n",
    "# model; they do not include variability from re-training.\n",
    "# ============================================================\n",
    "rng = np.random.RandomState(SEED)\n",
    "yt, yp, ypr = y_test.values, y_pred, y_prob\n",
    "boot = {k: [] for k in metrics}\n",
    "\n",
    "for _ in range(N_BOOT):\n",
    "    idx = rng.choice(len(yt), size=len(yt), replace=True)\n",
    "    if len(np.unique(yt[idx])) < 2:\n",
    "        continue\n",
    "    tn, fp, fn, tp = confusion_matrix(yt[idx], yp[idx], labels=[0, 1]).ravel()\n",
    "    boot[\"Accuracy\"].append(accuracy_score(yt[idx], yp[idx]))\n",
    "    boot[\"Precision\"].append(precision_score(yt[idx], yp[idx], zero_division=0))\n",
    "    boot[\"Recall\"].append(recall_score(yt[idx], yp[idx], zero_division=0))\n",
    "    boot[\"Specificity\"].append(tn / (tn + fp) if (tn + fp) else 0.0)\n",
    "    boot[\"F1 Score\"].append(f1_score(yt[idx], yp[idx], zero_division=0))\n",
    "    boot[\"ROC-AUC\"].append(roc_auc_score(yt[idx], ypr[idx]))\n",
    "\n",
    "ci = pd.DataFrame({\n",
    "    \"Metric\": list(metrics),\n",
    "    \"Estimate\": [round(v, 4) for v in metrics.values()],\n",
    "    \"CI lower (2.5%)\": [round(np.percentile(boot[k], 2.5), 4) for k in metrics],\n",
