    "\n",
    "cm = confusion_matrix(y_test, y_pred, labels=[0, 1])\n",
    "TN, FP, FN, TP = cm.ravel()\n",
    "\n",
    "metrics = {\n",
    "    \"Accuracy\":    accuracy_score(y_test, y_pred),\n",
    "    \"Precision\":   precision_score(y_test, y_pred),\n",
    "    \"Recall\":      recall_score(y_test, y_pred),\n",
    "    \"Specificity\": TN / (TN + FP),\n",
    "    \"F1 Score\":    f1_score(y_test, y_pred),\n",
    "    \"ROC-AUC\":     roc_auc_score(y_test, y_prob),\n",
    "}\n",
    "for k, v in metrics.items():\n",
    "    print(f\"{k:<12}: {v:.4f}\")\n",
    "print(f\"Confusion matrix: TP={TP}, FN={FN}, TN={TN}, FP={FP}\")\n",
    "\n",
    "# Same layout as the other models' result files, plus the CV AUC and the counts\n",
    "results = pd.DataFrame({\n",
    "    \"Metric\": list(metrics) + [\"5 Fold CV ROC-AUC\", \"TP\", \"FN\", \"TN\", \"FP\"],\n",
    "    \"Value\":  list(metrics.values()) + [cv_auc, TP, FN, TN, FP],\n",
    "})\n",
    "results.to_csv(\"XGBoost_Results.csv\", index=False)\n",
