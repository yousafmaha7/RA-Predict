    "# ============================================================\n",
    "# DATA, SAFETY CHECKS AND THE 80:20 STRATIFIED SPLIT\n",
    "# ============================================================\n",
    "df = pd.read_csv(\"RA_ML_Coded_1.csv\")\n",
    "\n",
    "# Safety check 1: this notebook is for the 17-feature dataset only\n",
    "assert df.shape == (400, 18), (\n",
    "    f\"Expected 400 rows x 18 columns (17 features + RA), found {df.shape}. \"\n",
    "    \"This looks like the old 26-column file; do not run this notebook on it.\")\n",
    "assert set(df[\"RA\"].unique()) == {0, 1} and df[\"RA\"].sum() == 200, \"RA must be coded 0/1 with 200 cases\"\n",
    "\n",
    "X = df.drop(\"RA\", axis=1)\n",
    "y = df[\"RA\"]\n",
    "print(\"features:\", X.shape[1])\n",
    "print(\"column names ending with a space:\", [c for c in X.columns if c != c.strip()])\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=TEST_SIZE, stratify=y, random_state=SEED)\n",
    "\n",
    "train_data = pd.concat([X_train, y_train], axis=1)\n",
    "test_data  = pd.concat([X_test,  y_test],  axis=1)\n",
    "print(\"training:\", train_data.shape, \"| RA =\", int(y_train.sum()),\n",
    "      \"|| test:\", test_data.shape, \"| RA =\", int(y_test.sum()))\n",
    "\n",
    "# Safety check 2: never overwrite an existing split file with different content\n",
    "for fname, new in [(\"RA_Training_Data.csv\", train_data), (\"RA_Testing_Data.csv\", test_data)]:\n",
    "    if os.path.exists(fname):\n",
    "        old = pd.read_csv(fname)\n",
    "        same = (old.shape == new.shape and list(old.columns) == list(new.columns)\n",
    "                and np.allclose(old.values.astype(float), new.values.astype(float)))\n",
    "        if not same:\n",
    "            raise RuntimeError(f\"{fname} already exists and differs from this split. \"\n",
    "                               \"Move or rename it before running, so other notebooks are not broken.\")\n",
    "        print(f\"{fname}: identical to the existing file (left unchanged)\")\n",
    "    else:\n",
    "        new.to_csv(fname, index=False)\n",
    "        print(f\"{fname}: written\")\n"
